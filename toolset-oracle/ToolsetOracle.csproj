<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ToolsetOracle</RootNamespace>
    <AssemblyName>toolset-oracle</AssemblyName>
  </PropertyGroup>

  <!-- Dev-only helper: never staged to dist/ and never embedded in the editor. -->
  <ItemGroup>
    <Compile Include="..\toolset-bridge\AssemblyResolver.cs" Link="Shared\AssemblyResolver.cs" />
    <Compile Include="..\toolset-bridge\Json.cs" Link="Shared\Json.cs" />
    <Compile Include="..\toolset-bridge\Logging.cs" Link="Shared\Logging.cs" />
    <Compile Include="..\toolset-bridge\IsExternalInit.cs" Link="Shared\IsExternalInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="NWN2Toolset64">
      <HintPath>..\toolset-bridge\bin\Debug\NWN2Toolset64.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OEIShared64">
      <HintPath>..\toolset-bridge\bin\Debug\OEIShared64.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ManagedResourceInterface64">
      <HintPath>..\toolset-bridge\bin\Debug\ManagedResourceInterface64.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
